<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Allergen matrix for Pala Pizza.">
<title>Pala Pizza | Allergen Matrix</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
body{margin:0;padding:0;background:#F7F5F3;color:#000;font-family:'Cabin',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;line-height:1.6;overflow-x:hidden}
:root{--olive:#686A49;--olive-light:#7a7f5c;--cream:#F7F5F3;--warm:#F3EDE6;--charcoal:#1a1a1a;--mid:#5a5a5a;--light:#999}

.nav{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;background:var(--olive)}
.nav-logo{height:32px;width:auto;filter:brightness(0) invert(1)}
.nav-links{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav-links a{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:rgba(247,245,243,0.75);font-family:Arial,Helvetica,sans-serif;transition:color .3s}
.nav-links a:hover,.nav-links a.active{color:#F7F5F3}
@media(max-width:600px){.nav{padding:14px 20px}.nav-links{gap:18px}.nav-links a{font-size:11px}}

.page-header{text-align:center;padding:72px 24px 40px}
.page-header h1{font-size:clamp(36px,5vw,52px);font-weight:400;margin-bottom:12px}
.page-header p{font-size:17px;color:var(--mid);max-width:460px;margin:0 auto;font-family:Arial,Helvetica,sans-serif}

.search-wrap{max-width:560px;margin:0 auto 32px;padding:0 24px}
.search-input{width:100%;font-family:'Cabin',sans-serif;font-size:15px;font-weight:400;padding:14px 20px;border-radius:100px;border:1px solid rgba(0,0,0,0.10);background:#fff;outline:none;transition:border-color .3s, box-shadow .3s}
.search-input:focus{border-color:var(--olive);box-shadow:0 0 0 3px rgba(99,104,69,0.1)}
.search-input::placeholder{color:#bbb}

.content{max-width:1040px;margin:0 auto;padding:0 24px 40px}

.scroll-hint{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--light);text-align:right;margin:0 4px 10px}
.table-shell{position:relative;background:#fff;border:1px solid rgba(0,0,0,0.08);border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.04)}
.table-shell::after{content:'';position:absolute;top:0;right:0;width:40px;height:100%;pointer-events:none;background:linear-gradient(to right,rgba(255,255,255,0),rgba(255,255,255,1))}
.table-scroll{overflow:auto;max-height:68vh;-webkit-overflow-scrolling:touch}
table{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%;font-family:'Cabin',sans-serif}
thead th{position:sticky;top:0;background:var(--olive);color:#fff;border-bottom:none;padding:14px 16px;font-size:11px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;text-align:center;white-space:nowrap;z-index:3}
thead th:first-child{text-align:left;z-index:4;left:0;background:var(--olive)}
tbody tr{transition:background .15s}
tbody tr:hover{background:rgba(99,104,69,0.03)}
tbody th{position:sticky;left:0;background:#fff;border-right:1px solid rgba(0,0,0,0.06);padding:13px 16px;font-size:13px;font-weight:500;letter-spacing:0.04em;text-transform:uppercase;white-space:nowrap;z-index:2;text-align:left}
tbody tr:hover th{background:rgba(250,248,245,1)}
tbody td{padding:12px 16px;text-align:center;border-bottom:1px solid rgba(0,0,0,0.04);font-size:14px;min-width:72px}
td.yes{font-weight:500;color:var(--olive)}
td.no{opacity:0.3}
td.other{font-size:12px;opacity:0.8}
.table-scroll::-webkit-scrollbar{height:8px;width:8px}
.table-scroll::-webkit-scrollbar-thumb{background:rgba(0,0,0,0.18);border-radius:6px}
.table-scroll::-webkit-scrollbar-track{background:rgba(0,0,0,0.03)}

.cards{display:none}
.card{background:#fff;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:20px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,0.03)}
.card-title{font-family:'Cabin',system-ui,sans-serif;font-size:18px;font-weight:400;margin-bottom:12px}
.chip-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
.chip{border:1px solid rgba(0,0,0,0.08);border-radius:100px;padding:6px 12px;font-size:11px;font-weight:400;letter-spacing:0.06em;text-transform:uppercase;background:var(--warm);white-space:nowrap}
.chip strong{margin-right:4px;font-weight:600}
.chip--contains{background:rgba(99,104,69,0.1);border-color:rgba(99,104,69,0.2);color:var(--olive)}
.chip--advisory{background:rgba(200,160,60,0.08);border-color:rgba(200,160,60,0.2);color:#8a6d20}
.empty-note{font-size:13px;color:var(--light)}
@media(max-width:720px){.scroll-hint{display:none}.table-shell{display:none}.cards{display:block}}

.allergen-notice{max-width:600px;margin:32px auto 0;padding:24px;text-align:center;font-size:13px;line-height:1.7;color:var(--mid);background:var(--warm);border-radius:12px}

.site-footer{background:#686A49;color:#F7F5F3;text-align:center;padding:24px 16px;font-size:14px;letter-spacing:0.12em;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;margin-top:64px}
.site-footer a{color:#F7F5F3;text-decoration:none}
.site-footer a:hover{text-decoration:underline}
</style>
</head>
<body>

<nav class="nav">
  <a href="/"><img src="/images/logo.png" alt="Pala Pizza" class="nav-logo"></a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/allergens" class="active">Allergens</a></li>
  </ul>
</nav>

<header class="page-header">
  <h1>Allergens</h1>
  <p>Always speak to staff if you have an allergy or intolerance.</p>
</header>

<div class="search-wrap">
  <input type="search" id="searchBox" class="search-input" placeholder="Search for a dish..." autocomplete="off">
</div>

<main class="content">
  <% if (matrix.length === 0) { %>
    <p style="text-align:center;color:var(--light);padding:48px 0;">No allergen data available yet. Please speak to staff directly.</p>
  <% } else { %>

  <div class="scroll-hint">&larr; Scroll horizontally to see all allergens &rarr;</div>

  <section class="table-shell" id="tableShell">
    <div class="table-scroll" id="tableScroll">
      <table id="matrixTable">
        <thead>
          <tr>
            <th>Dish</th>
            <% allergens.forEach(a => { %>
            <th><%= a.name %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% matrix.forEach(row => { %>
          <tr data-name="<%= row.name.toLowerCase() %>">
            <th><%= row.name %></th>
            <% row.values.forEach(v => { %>
              <% const vl = (v || '').trim().toLowerCase(); %>
              <% if (['y','yes','true','1','contains'].includes(vl)) { %>
                <td class="yes">&#10003;</td>
              <% } else if (!v || ['n','no','false','0'].includes(vl)) { %>
                <td class="no">&ndash;</td>
              <% } else { %>
                <td class="other"><%= v %></td>
              <% } %>
            <% }) %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="cards" id="cards">
    <% matrix.forEach(row => { %>
    <article class="card" data-name="<%= row.name.toLowerCase() %>">
      <div class="card-title"><%= row.name %></div>
      <% const present = []; const advisory = []; %>
      <% row.values.forEach((v, i) => { %>
        <% const vl = (v || '').trim().toLowerCase(); %>
        <% if (['y','yes','true','1','contains'].includes(vl)) present.push(allergens[i].name); %>
        <% if (v && !['y','yes','true','1','contains','n','no','false','0'].includes(vl)) advisory.push({name: allergens[i].name, note: v}); %>
      <% }) %>
      <% if (present.length) { %>
        <div class="chip-row">
          <% present.forEach(a => { %>
          <span class="chip chip--contains"><strong>&#10003;</strong><%= a %></span>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-note">No allergens marked as present.</p>
      <% } %>
      <% if (advisory.length) { %>
        <div class="chip-row">
          <% advisory.forEach(a => { %>
          <span class="chip chip--advisory"><strong>&#9888;</strong><%= a.name %> &ndash; <%= a.note %></span>
          <% }) %>
        </div>
      <% } %>
    </article>
    <% }) %>
  </section>

  <% } %>

  <div class="allergen-notice">
    All our food is prepared in a kitchen that handles allergens. While we take care to avoid cross-contamination, we cannot guarantee traces won't be present. Please speak to staff before ordering.
  </div>
</main>

<footer class="site-footer">
  <a href="<%= settings.maps_url || 'https://maps.app.goo.gl/refCJDhQGju6NiAx9' %>" target="_blank" rel="noopener">
    <%= settings.address_line1 || '7 Jane Street' %> | <%= settings.address_line2 || 'Leith' %>
  </a>
  <br><br>
  <a href="<%= settings.instagram_url || 'https://instagram.com/pala.edin' %>" target="_blank" rel="noopener">
    @pala.edin | Instagram
  </a>
  <br><br>
  <a href="/privacy" style="font-size:11px;opacity:0.7">Privacy Policy</a>
</footer>

<script>
document.getElementById('searchBox').addEventListener('input', function() {
  const q = this.value.trim().toLowerCase();
  document.querySelectorAll('[data-name]').forEach(el => {
    el.style.display = !q || el.dataset.name.includes(q) ? '' : 'none';
  });
});
</script>
</body>
</html>
