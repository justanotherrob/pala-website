<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow">
<meta name="description" content="Roman-style pizza by the slice in Leith, Edinburgh. Pizza al taglio with crisp bases and seasonal toppings, all made fresh at Jane Street.">
<meta property="og:title" content="Pala Pizza Leith | Pizza al Taglio Romana">
<meta property="og:description" content="Roman-style pizza by the slice in Leith, Edinburgh. Baked crisp and cut to order.">
<meta property="og:image" content="/images/header-image2.jpg">
<meta property="og:type" content="website">
<title>Pala Pizza Leith | Pizza al Taglio Romana</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:#FAF8F5;
  color:#1a1a1a;
  font-family:'Cabin', system-ui, -apple-system, sans-serif;
  font-weight:400;
  line-height:1.6;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

:root{
  --olive:#636845;
  --olive-light:#7a7f5c;
  --cream:#FAF8F5;
  --warm:#F3EDE6;
  --charcoal:#1a1a1a;
  --mid:#5a5a5a;
  --light:#999;
}

/* Nav */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 40px;
  transition:background .4s, box-shadow .4s, padding .4s;
}
.nav.scrolled{
  background:rgba(250,248,245,0.92);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  box-shadow:0 1px 0 rgba(0,0,0,0.06);padding:14px 40px;
}
.nav-logo{height:36px;width:auto;transition:filter .4s, height .4s}
.nav:not(.scrolled) .nav-logo{filter:brightness(0) invert(1);height:40px}
.nav-links{display:flex;gap:32px;list-style:none}
.nav-links a{
  font-size:13px;font-weight:400;letter-spacing:0.14em;text-transform:uppercase;
  text-decoration:none;color:var(--charcoal);transition:color .3s;position:relative;
}
.nav:not(.scrolled) .nav-links a{color:#fff}
.nav-links a::after{
  content:'';position:absolute;bottom:-4px;left:0;
  width:0;height:1px;background:currentColor;transition:width .3s;
}
.nav-links a:hover::after{width:100%}

@media(max-width:600px){
  .nav{padding:16px 20px}.nav.scrolled{padding:12px 20px}
  .nav-links{gap:20px}.nav-links a{font-size:11px;letter-spacing:0.1em}
}

/* Hero */
.hero{position:relative;width:100%;height:100vh;min-height:600px;overflow:hidden}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 60%}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.25) 0%,rgba(0,0,0,0.10) 40%,rgba(0,0,0,0.45) 100%)}
.hero-content{position:absolute;bottom:0;left:0;right:0;padding:0 40px 72px;color:#fff}
.hero-tagline{font-size:13px;font-weight:400;letter-spacing:0.2em;text-transform:uppercase;margin-bottom:16px;opacity:0.85}
.hero-title{font-family:'Cabin',system-ui,sans-serif;font-size:clamp(42px,7vw,80px);font-weight:400;line-height:1.05;margin-bottom:20px}
.hero-title em{font-style:italic}
.hero-sub{font-size:18px;font-weight:300;max-width:460px;opacity:0.9;line-height:1.6}
.hero-scroll{
  position:absolute;bottom:28px;left:50%;transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  color:rgba(255,255,255,0.6);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;
  animation:pulse 2s ease-in-out infinite;
}
.hero-scroll svg{width:20px;height:20px}
@keyframes pulse{
  0%,100%{opacity:0.6;transform:translateX(-50%) translateY(0)}
  50%{opacity:1;transform:translateX(-50%) translateY(4px)}
}
@media(max-width:600px){.hero{min-height:100svh}.hero-content{padding:0 24px 60px}.hero-sub{font-size:16px}}

/* Section */
.section{padding:100px 40px;max-width:900px;margin:0 auto}
.section-label{font-size:12px;font-weight:400;letter-spacing:0.2em;text-transform:uppercase;color:var(--olive);margin-bottom:20px}
.section-heading{font-family:'Cabin',system-ui,sans-serif;font-size:clamp(32px,5vw,48px);font-weight:400;line-height:1.15;margin-bottom:16px}
.section-sub{font-size:17px;color:var(--mid);max-width:520px;line-height:1.7}
@media(max-width:600px){.section{padding:64px 24px}}

/* Hours Strip */
.hours-strip{background:var(--olive);color:var(--cream);text-align:center;padding:48px 24px}
.hours-grid{display:flex;justify-content:center;gap:48px;flex-wrap:wrap;max-width:600px;margin:0 auto}
.hours-day{text-align:center}
.hours-day .day{font-size:12px;letter-spacing:0.18em;text-transform:uppercase;opacity:0.7;margin-bottom:6px}
.hours-day .time{font-family:'Cabin',system-ui,sans-serif;font-size:22px}

/* Menu */
.menu-section{background:var(--warm)}
.menu-inner{max-width:760px;margin:0 auto;padding:100px 40px}
.menu-card{background:#fff;border-radius:16px;padding:56px 48px 64px;box-shadow:0 8px 40px rgba(0,0,0,0.06);text-align:center}
.menu-card-logo{display:block;margin:0 auto 12px;width:120px;height:auto;opacity:0.85}
.menu-card-label{font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--olive);margin-bottom:48px}
.menu-divider{width:40px;height:1px;background:var(--olive);margin:0 auto 48px;opacity:0.4}
.menu-item{margin-bottom:40px}
.menu-item:last-child{margin-bottom:0}
.menu-item-name{font-family:'Cabin',system-ui,sans-serif;font-size:clamp(28px,4vw,36px);font-weight:400;line-height:1.2;margin-bottom:4px}
.menu-item-tag{font-size:15px;color:var(--mid);font-style:italic;margin-bottom:6px}
.menu-item-price{font-size:20px;color:var(--olive);letter-spacing:0.06em}
.menu-empty{font-size:16px;color:var(--light);padding:40px 0}
@media(max-width:600px){.menu-inner{padding:64px 20px}.menu-card{padding:40px 24px 48px}}

/* CTA Row */
.cta-row{display:grid;grid-template-columns:1fr 1fr;gap:0}
.cta-block{padding:80px 48px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}
.cta-block:first-child{background:var(--cream)}
.cta-block:nth-child(2){background:var(--olive);color:var(--cream)}
.cta-block:nth-child(3){background:var(--charcoal);color:var(--cream)}
.cta-icon{width:48px;height:48px;margin-bottom:20px;opacity:0.7}
.cta-block:nth-child(2) .cta-icon,.cta-block:nth-child(3) .cta-icon{opacity:0.6}
.cta-heading{font-family:'Cabin',system-ui,sans-serif;font-size:24px;font-weight:400;margin-bottom:12px}
.cta-desc{font-size:15px;line-height:1.7;max-width:300px;margin-bottom:24px;color:var(--mid)}
.cta-block:nth-child(2) .cta-desc,.cta-block:nth-child(3) .cta-desc{color:rgba(250,248,245,0.7)}
.cta-btn{display:inline-block;padding:13px 32px;font-size:12px;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;text-decoration:none;border-radius:100px;transition:all .3s}
.cta-btn--outline{border:1px solid var(--charcoal);color:var(--charcoal)}
.cta-btn--outline:hover{background:var(--charcoal);color:var(--cream)}
.cta-btn--white{border:1px solid rgba(250,248,245,0.5);color:var(--cream)}
.cta-btn--white:hover{background:var(--cream);color:var(--olive)}
.cta-btn--cream{border:1px solid rgba(250,248,245,0.5);color:var(--cream)}
.cta-btn--cream:hover{background:var(--cream);color:var(--charcoal)}
@media(max-width:700px){.cta-row{grid-template-columns:1fr}.cta-block{padding:56px 32px}}

/* Footer */
.footer{background:var(--charcoal);color:#ccc;padding:56px 40px}
.footer-inner{max-width:900px;margin:0 auto;display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:40px}
.footer-brand{flex:1;min-width:200px}
.footer-logo{height:32px;width:auto;filter:brightness(0) invert(1);margin-bottom:16px;opacity:0.8}
.footer-address{font-size:14px;line-height:1.8}
.footer-address a{color:#ccc;text-decoration:none;transition:color .3s}
.footer-address a:hover{color:#fff}
.footer-col{text-align:right}
.footer-col a{display:block;font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:#888;text-decoration:none;margin-bottom:12px;transition:color .3s}
.footer-col a:hover{color:#fff}
.footer-copy{max-width:900px;margin:40px auto 0;padding-top:24px;border-top:1px solid rgba(255,255,255,0.08);font-size:12px;color:#555;text-align:center;letter-spacing:0.06em}
@media(max-width:600px){.footer{padding:40px 24px}.footer-inner{flex-direction:column;gap:28px}.footer-col{text-align:left}}

/* Fade-in */
.fade-in{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease}
.fade-in.visible{opacity:1;transform:translateY(0)}
</style>
</head>
<body>

<!-- Nav -->
<nav class="nav" id="nav">
  <a href="/"><img src="/images/logoblack.png" alt="Pala Pizza" class="nav-logo"></a>
  <ul class="nav-links">
    <li><a href="#menu">Menu</a></li>
    <li><a href="/allergens">Allergens</a></li>
    <% if (settings.gift_cards_enabled === 'true') { %>
    <li><a href="/gift-cards">Gift Cards</a></li>
    <% } %>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- Hero -->
<header class="hero">
  <img src="/images/header-image2.jpg" alt="Roman-style pizza al taglio on a wooden counter" class="hero-img">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-tagline"><%= settings.tagline || 'Leith, Edinburgh' %></p>
    <h1 class="hero-title"><%- settings.hero_title || 'Pizza <em>al Taglio</em><br>Romana' %></h1>
    <p class="hero-sub"><%= settings.hero_subtitle || 'Baked crisp. Cut to order. Roman-style pizza by the slice from our kitchen on Jane Street.' %></p>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</header>

<!-- Hours -->
<section class="hours-strip fade-in">
  <div class="hours-grid">
    <% hours.forEach(h => { %>
    <div class="hours-day">
      <div class="day"><%= h.label %></div>
      <div class="time"><%- h.times %></div>
    </div>
    <% }) %>
  </div>
</section>

<!-- About -->
<section class="section fade-in" style="text-align:center">
  <p class="section-label">About</p>
  <h2 class="section-heading">The Art of <em style="font-family:'Cabin',system-ui,sans-serif;font-style:italic">al Taglio</em></h2>
  <p class="section-sub" style="margin:0 auto;max-width:560px">
    <%= settings.about_text || 'Pizza al taglio — Roman-style pizza baked in long trays, crisp on the outside, light and airy within.' %>
  </p>
</section>

<!-- Menu -->
<section class="menu-section" id="menu">
  <div class="menu-inner">
    <div class="menu-card fade-in">
      <img src="/images/logoblack.png" alt="Pala Pizza" class="menu-card-logo">
      <div class="menu-card-label">Today's Menu</div>
      <div class="menu-divider"></div>
      <div id="items">
        <% if (menuItems.length === 0) { %>
          <p class="menu-empty">Menu coming soon &mdash; pop in to see what's fresh.</p>
        <% } else { %>
          <% menuItems.forEach(item => { %>
          <div class="menu-item">
            <div class="menu-item-name"><%= item.name %></div>
            <% if (item.tag) { %><div class="menu-item-tag"><%= item.tag %></div><% } %>
            <% if (item.price) { %><div class="menu-item-price">&pound;<%= (item.price / 100).toFixed(2) %></div><% } %>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- CTA Row -->
<section class="cta-row" id="contact">
  <div class="cta-block fade-in">
    <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M9 12h6M12 9v6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
    </svg>
    <h3 class="cta-heading">Allergen Info</h3>
    <p class="cta-desc">Full allergen matrix for every item on our menu. Always speak to staff about any allergy or intolerance.</p>
    <a href="/allergens" class="cta-btn cta-btn--outline">View Allergens</a>
  </div>
  <div class="cta-block fade-in">
    <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10c0-.63.3-1.22.8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/>
      <path d="m22 10-8.97 5.7a2 2 0 0 1-2.06 0L2 10"/>
    </svg>
    <h3 class="cta-heading">Full Trays & Orders</h3>
    <p class="cta-desc">Walk in for slices or email us about full trays and advance orders for your next event.</p>
    <a href="#" id="emailLink" class="cta-btn cta-btn--white">Get In Touch</a>
  </div>
  <% if (settings.gift_cards_enabled === 'true') { %>
  <div class="cta-block fade-in">
    <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
    </svg>
    <h3 class="cta-heading">Gift Cards</h3>
    <p class="cta-desc">Give the gift of pizza. Buy a Pala Pizza gift card for yourself or send one to a friend.</p>
    <a href="/gift-cards" class="cta-btn cta-btn--cream">Buy Gift Card</a>
  </div>
  <% } %>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src="/images/logo.png" alt="Pala Pizza" class="footer-logo">
      <div class="footer-address">
        <a href="<%= settings.maps_url || '#' %>" target="_blank" rel="noopener">
          <%= settings.address_line1 || '7 Jane Street' %><br><%= settings.address_line2 || 'Leith, Edinburgh' %>
        </a>
      </div>
    </div>
    <div class="footer-col">
      <a href="<%= settings.instagram_url || '#' %>" target="_blank" rel="noopener">Instagram</a>
      <a href="<%= settings.maps_url || '#' %>" target="_blank" rel="noopener">Directions</a>
      <a href="/allergens">Allergens</a>
      <% if (settings.gift_cards_enabled === 'true') { %>
      <a href="/gift-cards">Gift Cards</a>
      <% } %>
    </div>
  </div>
  <div class="footer-copy">&copy; Pala Pizza Leith</div>
</footer>

<script>
const nav = document.getElementById('nav');
const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 60);
window.addEventListener('scroll', onScroll, {passive:true});
onScroll();

const faders = document.querySelectorAll('.fade-in');
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }});
}, {threshold:0.15});
faders.forEach(f => io.observe(f));

(function(){
  const user = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[0] %>";
  const domain = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[1] %>";
  const subject = "<%= settings.email_subject || 'Website order/Query' %>";
  const link = document.getElementById("emailLink");
  if(!link) return;
  link.href = "mailto:" + user + "@" + domain + "?subject=" + encodeURIComponent(subject);
})();
</script>
</body>
</html>
