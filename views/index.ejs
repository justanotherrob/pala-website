<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow">
<meta name="description" content="Roman-style pizza by the slice in Leith, Edinburgh. Pizza al taglio with crisp bases and seasonal toppings, all made fresh at Jane Street.">
<meta property="og:title" content="Pala Pizza Leith | Pizza al Taglio Romana">
<meta property="og:description" content="Roman-style pizza by the slice in Leith, Edinburgh. Baked crisp and cut to order.">
<meta property="og:image" content="/images/header-image2.jpg">
<meta property="og:type" content="website">
<title>Pala Pizza Leith | Pizza al Taglio Romana</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  padding: 0;
  background: #F7F5F3;
  color: #000;
  font-family: "Cabin", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
}

/* Sticky nav — desktop only, slides in on scroll */
.sticky-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 40px;
  background: #686A49;
  transform: translateY(-100%);
  transition: transform 0.3s ease;
}
.sticky-nav.visible { transform: translateY(0); }
.sticky-nav .nav-logo { height: 32px; width: auto; filter: brightness(0) invert(1); }
.sticky-nav .nav-links { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
.sticky-nav .nav-links a {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  color: rgba(247,245,243,0.75);
  font-family: Arial, Helvetica, sans-serif;
  transition: color .3s;
}
.sticky-nav .nav-links a:hover,
.sticky-nav .nav-links a.active { color: #F7F5F3; }
@media (max-width: 768px) {
  .sticky-nav { padding: 10px 16px; }
  .sticky-nav .nav-logo { height: 24px; }
  .sticky-nav .nav-links { gap: 16px; }
  .sticky-nav .nav-links a { font-size: 11px; letter-spacing: 0.06em; }
}

/* Hero */

.hero {
  width: 100%;
  height: 100vh;
  min-height: 500px;
  background-image: url("/images/header-image2.jpg");
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-logo {
  max-width: 420px;
  width: 60%;
}

@media (max-width: 768px) {
  .hero { min-height: 60vh; }
  .hero-logo { max-width: 260px; }
}

/* Intro */

.intro {
  text-align: center;
  padding: 48px 20px 24px;
  letter-spacing: 0.08em;
  font-size: 20px;
  line-height: 1.6;
  font-family: Arial, Helvetica, sans-serif;
}

.intro h1 {
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 50px;
}

.intro h2 {
  margin-bottom: 24px;
  font-size: 24px;
  font-weight: 400;
  color: #333;
}

@media (max-width: 520px) {
  .intro h1 { font-size: 32px; }
  .intro h2 { font-size: 18px; }
}

/* Menu */

.menu {
  max-width: 760px;
  margin: auto;
  padding: 32px 20px 56px;
  text-align: center;
}

.menu-card {
  background: #fffdf9;
  border: 1px solid #eee6dc;
  padding: 40px 28px 48px;
  border-radius: 6px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
}

.menu-logo {
  display: block;
  margin: auto auto 24px;
  max-width: 180px;
  width: 60%;
}

.intro-title {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 28px;
  margin-bottom: 24px;
  font-family: Arial, Helvetica, sans-serif;
}

.item {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 40px;
  margin: 36px 0;
}

.note {
  font-size: 22px;
  margin: -16px 0 18px;
}

.price {
  font-style: italic;
  font-size: 30px;
  letter-spacing: 0.08em;
}

.price--row {
  margin: 10px 0 28px;
}

.menu-empty {
  color: #888;
  font-size: 18px;
  padding: 32px 0;
  font-family: Arial, Helvetica, sans-serif;
}

@media (max-width: 520px) {
  .item { font-size: 32px; }
  .price { font-size: 24px; }
}

/* CTA */

.cta {
  max-width: 760px;
  margin: auto auto 64px;
  padding: 0 20px;
  text-align: center;
}

.cta-text {
  font-size: 18px;
  margin-bottom: 24px;
  line-height: 1.6;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}

.cta-button {
  display: inline-block;
  padding: 14px 28px;
  background: #686A49;
  color: #F7F5F3;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 4px;
  font-family: Arial, Helvetica, sans-serif;
}

.cta-button:hover { opacity: 0.9; }

/* Gift Card CTA — same style as other CTAs */
.gc-cta {
  max-width: 760px;
  margin: auto auto 64px;
  padding: 0 20px;
  text-align: center;
}

.gc-cta-text {
  font-size: 18px;
  margin-bottom: 24px;
  line-height: 1.6;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}

/* Footer */

.site-footer {
  background: #686A49;
  color: #F7F5F3;
  text-align: center;
  padding: 24px 16px;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-family: Arial, Helvetica, sans-serif;
}

.site-footer a {
  color: #F7F5F3;
  text-decoration: none;
}

.site-footer a:hover { text-decoration: underline; }

/* Announcement banner */
.announce-banner {
  background: #5c3d2e;
  color: #fff;
  text-align: center;
  padding: 12px 48px 12px 20px;
  font-size: 15px;
  font-family: Arial, Helvetica, sans-serif;
  letter-spacing: 0.02em;
  position: relative;
}
.announce-banner-close {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: rgba(255,255,255,0.7);
  font-size: 20px;
  cursor: pointer;
  line-height: 1;
}
.announce-banner-close:hover { color: #fff; }

/* Popup overlay */
.announce-popup-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.announce-popup {
  background: #F7F5F3;
  border-radius: 10px;
  max-width: 420px;
  width: 100%;
  padding: 36px 28px 28px;
  text-align: center;
  position: relative;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
}
.announce-popup h2 {
  font-size: 24px;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.announce-popup p {
  font-size: 16px;
  line-height: 1.6;
  color: #333;
  margin-bottom: 20px;
}
.announce-popup-close {
  display: inline-block;
  padding: 10px 32px;
  background: #686A49;
  color: #fff;
  border: none;
  border-radius: 100px;
  font-family: 'Cabin', sans-serif;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
}
.announce-popup-close:hover { background: #7a7f5c; }
</style>
</head>
<body>

<% if (settings.banner_enabled === 'true' && settings.banner_text) { %>
<div class="announce-banner" id="announceBanner">
  <%= settings.banner_text %>
  <button class="announce-banner-close" onclick="document.getElementById('announceBanner').remove()">&times;</button>
</div>
<% } %>

<% if (settings.popup_enabled === 'true' && (settings.popup_title || settings.popup_text)) { %>
<div class="announce-popup-overlay" id="announcePopup" style="display:none">
  <div class="announce-popup">
    <% if (settings.popup_title) { %><h2><%= settings.popup_title %></h2><% } %>
    <% if (settings.popup_text) { %><p><%= settings.popup_text %></p><% } %>
    <button class="announce-popup-close" onclick="document.getElementById('announcePopup').remove()">Got it</button>
  </div>
</div>
<% } %>

<nav class="sticky-nav" id="stickyNav">
  <a href="/"><img src="/images/logo.png" alt="Pala Pizza" class="nav-logo"></a>
  <ul class="nav-links">
    <li><a href="/" class="active">Home</a></li>
    <li><a href="/allergens">Allergens</a></li>
    <% if (settings.gift_cards_enabled === 'true') { %>
      <li><a href="/gift-cards">Gift Cards</a></li>
    <% } %>
  </ul>
</nav>

<header class="hero">
  <img src="/images/logo.png" alt="Pala Roman pizza logo" class="hero-logo">
</header>

<div class="intro">
  <h1>Pizza al Taglio Romana</h1>
  <h2>Roman-style pizza by the slice, baked crisp and cut to order.</h2>
  <% hours.forEach((h, i) => { %>
    <%= h.label %>: <%= h.times.replace(/<br\s*\/?>/g, ' ') %><% if (i < hours.length - 1) { %><br><% } %>
  <% }) %>
  <% if (tempHours && tempHours.length > 0) { %>
    <br><br>
    <% tempHours.forEach((th, i) => { %>
      <strong><%= th.label %></strong> (<%= th.dateFormatted %>): <%= th.times %><% if (i < tempHours.length - 1) { %><br><% } %>
    <% }) %>
  <% } %>
</div>

<main class="menu" id="menu">
  <div class="menu-card">
    <img src="/images/logoblack.png" alt="Pala" class="menu-logo">
    <div class="intro-title">Roman Style Pizza</div>

    <% const pizzaItems = menuItems.filter(i => i.category === 'pizza' || !i.category); %>
    <% const dessertItems = menuItems.filter(i => i.category === 'dessert'); %>

    <% if (pizzaItems.length === 0 && dessertItems.length === 0) { %>
      <p class="menu-empty">Menu coming soon &mdash; pop in to see what's fresh.</p>
    <% } else { %>

      <%/* Pizza items — names and tags only, shared price at the end */ %>
      <% pizzaItems.forEach(item => { %>
        <div class="item"><%= item.name %></div>
        <% if (item.tag) { %><div class="note"><%= item.tag %></div><% } %>
      <% }) %>
      <% if (pizzaItems.length > 0 && settings.pizza_price_label) { %>
        <div class="price price--row"><%= settings.pizza_price_label %></div>
      <% } %>

      <%/* Dessert items — each with its own price */ %>
      <% dessertItems.forEach(item => { %>
        <div class="item"><%= item.name %></div>
        <% if (item.tag) { %><div class="note"><%= item.tag %></div><% } %>
        <% if (item.price) { %><div class="price price--row">&pound;<%= (item.price / 100).toFixed(2) %></div><% } %>
      <% }) %>

    <% } %>
  </div>
</main>

<section class="cta">
  <p class="cta-text">View our full allergens information.</p>
  <a href="/allergens" class="cta-button">Allergens</a>
</section>

<% if (settings.gift_cards_enabled === 'true') { %>
<section class="gc-cta">
  <p class="gc-cta-text">
    Give the gift of pizza. Buy a Pala gift card<br>
    for yourself or send one to a friend.
  </p>
  <a href="/gift-cards" class="cta-button">Gift Cards</a>
</section>
<% } %>

<section class="cta">
  <p class="cta-text">
    Walk in to order by the slice or two. Wanting more?<br>
    Email us about full trays and advance orders.
  </p>
  <a href="#" id="emailLink" class="cta-button">Email Here</a>
</section>

<footer class="site-footer">
  <a href="<%= settings.maps_url || 'https://maps.app.goo.gl/refCJDhQGju6NiAx9' %>" target="_blank" rel="noopener">
    <%= settings.address_line1 || '7 Jane Street' %> | <%= settings.address_line2 || 'Leith' %>
  </a>
  <br><br>
  <a href="<%= settings.instagram_url || 'https://instagram.com/pala.edin' %>" target="_blank" rel="noopener">
    @pala.edin | Instagram
  </a>
  <br><br>
  <a href="/privacy" style="font-size:11px;opacity:0.7">Privacy Policy</a>
</footer>

<script>
(function(){
  var nav = document.getElementById('stickyNav');
  var hero = document.querySelector('.hero');
  if (nav && hero) {
    var onScroll = function() {
      var trigger = hero.offsetHeight - 80;
      if (window.scrollY > trigger) nav.classList.add('visible');
      else nav.classList.remove('visible');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
})();
(function(){
  var user = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[0] %>";
  var domain = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[1] %>";
  var subject = "<%= settings.email_subject || 'Website order/Query' %>";
  var link = document.getElementById("emailLink");
  if(!link) return;
  link.href = "mailto:" + user + "@" + domain + "?subject=" + encodeURIComponent(subject);
})();
(function(){
  var popup = document.getElementById('announcePopup');
  if (!popup) return;
  if (sessionStorage.getItem('popup_dismissed')) return;
  popup.style.display = '';
  popup.addEventListener('click', function(e) {
    if (e.target === popup || e.target.classList.contains('announce-popup-close')) {
      sessionStorage.setItem('popup_dismissed', '1');
      popup.remove();
    }
  });
})();
</script>
</body>
</html>
