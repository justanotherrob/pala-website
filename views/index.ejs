<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow">
<meta name="description" content="Roman-style pizza by the slice in Leith, Edinburgh. Pizza al taglio with crisp bases and seasonal toppings, all made fresh at Jane Street.">
<meta property="og:title" content="Pala Pizza Leith | Pizza al Taglio Romana">
<meta property="og:description" content="Roman-style pizza by the slice in Leith, Edinburgh. Baked crisp and cut to order.">
<meta property="og:image" content="/images/header-image2.jpg">
<meta property="og:type" content="website">
<title>Pala Pizza Leith | Pizza al Taglio Romana</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  padding: 0;
  background: #F7F5F3;
  color: #000;
  font-family: "Cabin", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
}

/* Hero */

.hero {
  width: 100%;
  height: 100vh;
  min-height: 500px;
  background-image: url("/images/header-image2.jpg");
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-logo {
  max-width: 420px;
  width: 60%;
}

@media (max-width: 768px) {
  .hero { min-height: 60vh; }
  .hero-logo { max-width: 260px; }
}

/* Intro */

.intro {
  text-align: center;
  padding: 48px 20px 24px;
  letter-spacing: 0.08em;
  font-size: 20px;
  line-height: 1.6;
  font-family: Arial, Helvetica, sans-serif;
}

.intro h1 {
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 50px;
}

.intro h2 {
  margin-bottom: 24px;
  font-size: 24px;
  font-weight: 400;
  color: #333;
}

@media (max-width: 520px) {
  .intro h1 { font-size: 32px; }
  .intro h2 { font-size: 18px; }
}

/* Menu */

.menu {
  max-width: 760px;
  margin: auto;
  padding: 32px 20px 56px;
  text-align: center;
}

.menu-card {
  background: #fffdf9;
  border: 1px solid #eee6dc;
  padding: 40px 28px 48px;
  border-radius: 6px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
}

.menu-logo {
  display: block;
  margin: auto auto 24px;
  max-width: 180px;
  width: 60%;
}

.intro-title {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 28px;
  margin-bottom: 24px;
  font-family: Arial, Helvetica, sans-serif;
}

.item {
  font-weight: 700;
  text-transform: uppercase;
  font-size: 40px;
  margin: 36px 0;
}

.note {
  font-size: 22px;
  margin: -16px 0 18px;
}

.price {
  font-style: italic;
  font-size: 30px;
  letter-spacing: 0.08em;
}

.price--row {
  margin: 10px 0 28px;
}

.menu-empty {
  color: #888;
  font-size: 18px;
  padding: 32px 0;
  font-family: Arial, Helvetica, sans-serif;
}

@media (max-width: 520px) {
  .item { font-size: 32px; }
  .price { font-size: 24px; }
}

/* CTA */

.cta {
  max-width: 760px;
  margin: auto auto 64px;
  padding: 0 20px;
  text-align: center;
}

.cta-text {
  font-size: 18px;
  margin-bottom: 24px;
  line-height: 1.6;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}

.cta-button {
  display: inline-block;
  padding: 14px 28px;
  background: #686A49;
  color: #F7F5F3;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 4px;
  font-family: Arial, Helvetica, sans-serif;
}

.cta-button:hover { opacity: 0.9; }

/* Gift Card CTA — same style as other CTAs */
.gc-cta {
  max-width: 760px;
  margin: auto auto 64px;
  padding: 0 20px;
  text-align: center;
}

.gc-cta-text {
  font-size: 18px;
  margin-bottom: 24px;
  line-height: 1.6;
  color: #222;
  font-family: Arial, Helvetica, sans-serif;
}

/* Footer */

.site-footer {
  background: #686A49;
  color: #F7F5F3;
  text-align: center;
  padding: 24px 16px;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-family: Arial, Helvetica, sans-serif;
}

.site-footer a {
  color: #F7F5F3;
  text-decoration: none;
}

.site-footer a:hover { text-decoration: underline; }
</style>
</head>
<body>

<header class="hero">
  <img src="/images/logo.png" alt="Pala Roman pizza logo" class="hero-logo">
</header>

<div class="intro">
  <h1>Pizza al Taglio Romana</h1>
  <h2>Roman-style pizza by the slice, baked crisp and cut to order.</h2>
  <% hours.forEach((h, i) => { %>
    <%= h.label %>: <%= h.times.replace(/<br\s*\/?>/g, ' ') %><% if (i < hours.length - 1) { %><br><% } %>
  <% }) %>
</div>

<main class="menu" id="menu">
  <div class="menu-card">
    <img src="/images/logoblack.png" alt="Pala" class="menu-logo">
    <div class="intro-title">Roman Style Pizza</div>

    <% if (menuItems.length === 0) { %>
      <p class="menu-empty">Menu coming soon &mdash; pop in to see what's fresh.</p>
    <% } else { %>
      <% menuItems.forEach(item => { %>
        <div class="item"><%= item.name %></div>
        <% if (item.tag) { %><div class="note"><%= item.tag %></div><% } %>
        <% if (item.price) { %><div class="price price--row">&pound;<%= (item.price / 100).toFixed(2) %></div><% } %>
      <% }) %>
    <% } %>
  </div>
</main>

<section class="cta">
  <p class="cta-text">View our full allergens information.</p>
  <a href="/allergens" class="cta-button">Allergens</a>
</section>

<% if (settings.gift_cards_enabled === 'true') { %>
<section class="gc-cta">
  <p class="gc-cta-text">
    Give the gift of pizza. Buy a Pala gift card<br>
    for yourself or send one to a friend.
  </p>
  <a href="/gift-cards" class="cta-button">Gift Cards</a>
</section>
<% } %>

<section class="cta">
  <p class="cta-text">
    Walk in to order by the slice or two. Wanting more?<br>
    Email us about full trays and advance orders.
  </p>
  <a href="#" id="emailLink" class="cta-button">Email Here</a>
</section>

<footer class="site-footer">
  <a href="<%= settings.maps_url || 'https://maps.app.goo.gl/refCJDhQGju6NiAx9' %>" target="_blank" rel="noopener">
    <%= settings.address_line1 || '7 Jane Street' %> | <%= settings.address_line2 || 'Leith' %>
  </a>
  <br><br>
  <a href="<%= settings.instagram_url || 'https://instagram.com/pala.edin' %>" target="_blank" rel="noopener">
    @pala.edin | Instagram
  </a>
</footer>

<script>
(function(){
  var user = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[0] %>";
  var domain = "<%= (settings.email_address || 'ciao@palapizza.co.uk').split('@')[1] %>";
  var subject = "<%= settings.email_subject || 'Website order/Query' %>";
  var link = document.getElementById("emailLink");
  if(!link) return;
  link.href = "mailto:" + user + "@" + domain + "?subject=" + encodeURIComponent(subject);
})();
</script>
</body>
</html>
