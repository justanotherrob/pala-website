<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gift Card Confirmation | Pala Pizza</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
body{margin:0;padding:0;background:#F7F5F3;color:#000;font-family:'Cabin',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;line-height:1.6}

.nav{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;background:#686A49}
.nav-logo{height:32px;width:auto;filter:brightness(0) invert(1)}
.nav-links{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav-links a{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:rgba(247,245,243,0.75);font-family:Arial,Helvetica,sans-serif;transition:color .3s}
.nav-links a:hover{color:#F7F5F3}
@media(max-width:600px){.nav{padding:14px 20px}.nav-links{gap:18px}.nav-links a{font-size:11px}}

.success-page{max-width:500px;margin:0 auto;padding:100px 24px;text-align:center}
.check-icon{width:56px;height:56px;color:#686A49;margin:0 auto 20px}
.success-page h1{font-size:32px;font-weight:400;margin-bottom:16px}
.success-page p{color:#5a5a5a;font-size:16px;line-height:1.7;margin-bottom:12px;font-family:Arial,Helvetica,sans-serif}
.success-page strong{color:#000}
.home-link{
  display:inline-block;margin-top:32px;padding:14px 28px;
  font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;
  text-decoration:none;border-radius:4px;
  background:#686A49;color:#F7F5F3;font-family:Arial,Helvetica,sans-serif;
  transition:opacity .3s;
}
.home-link:hover{opacity:0.9}
.announce-banner{background:#5c3d2e;color:#fff;text-align:center;padding:12px 48px 12px 20px;font-size:15px;font-family:Arial,Helvetica,sans-serif;letter-spacing:0.02em;position:relative}
.announce-banner-close{position:absolute;right:16px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,0.7);font-size:20px;cursor:pointer;line-height:1}
.announce-banner-close:hover{color:#fff}
</style>
</head>
<body>

<% if (settings.banner_enabled === 'true' && settings.banner_text) { %>
<div class="announce-banner" id="announceBanner">
  <%= settings.banner_text %>
  <button class="announce-banner-close" onclick="document.getElementById('announceBanner').remove()">&times;</button>
</div>
<% } %>

<nav class="nav">
  <a href="/"><img src="/images/logo.png" alt="Pala Pizza" class="nav-logo"></a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/gift-cards">Gift Cards</a></li>
  </ul>
</nav>

<main class="success-page">
  <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>

  <% if (card && card.status === 'active') { %>
    <% if (card.send_to === 'friend') { %>
      <h1>Gift card sent!</h1>
      <p>We've emailed a <strong>&pound;<%= (card.initial_amount / 100).toFixed(0) %></strong> gift card to <strong><%= card.recipient_name %></strong> at <strong><%= card.recipient_email %></strong>.</p>
      <p>A receipt has been sent to your email.</p>
    <% } else { %>
      <h1>Gift card ready!</h1>
      <p>We've sent your <strong>&pound;<%= (card.initial_amount / 100).toFixed(0) %></strong> gift card to <strong><%= card.purchaser_email %></strong>.</p>
      <p>Check your inbox &mdash; it's ready to print and give in person.</p>
    <% } %>
  <% } else { %>
    <h1>Thank you!</h1>
    <p>Your payment has been received. Your gift card details will arrive by email shortly.</p>
    <p>If you don't receive an email within 10 minutes, please contact us at ciao@palapizza.co.uk.</p>
  <% } %>

  <a href="/" class="home-link">Back to Home</a>
</main>
</body>
</html>
