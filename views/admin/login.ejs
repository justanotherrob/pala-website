<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Login | Pala Pizza</title>
<link href="https://fonts.googleapis.com/css2?family=Cabin:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:#FAF8F5;font-family:'Cabin',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:24px}
.login-card{background:#fff;border-radius:16px;padding:48px 40px;max-width:380px;width:100%;box-shadow:0 8px 40px rgba(0,0,0,0.06)}
.login-card h1{font-size:24px;font-weight:400;text-align:center;margin-bottom:8px}
.login-card .sub{text-align:center;color:#5a5a5a;font-size:14px;margin-bottom:32px}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#5a5a5a;margin-bottom:6px}
.form-group input{width:100%;font-family:'Cabin',sans-serif;font-size:15px;padding:12px 16px;border:1px solid rgba(0,0,0,0.1);border-radius:10px;outline:none;transition:border-color .3s}
.form-group input:focus{border-color:#636845}
.error{background:#fef6f6;border:1px solid #f0d0d0;border-radius:10px;padding:10px 14px;color:#7a2020;font-size:13px;margin-bottom:16px}
.login-btn{width:100%;padding:14px;font-family:'Cabin',sans-serif;font-size:14px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;border:none;border-radius:100px;background:#636845;color:#fff;cursor:pointer;transition:background .3s;margin-top:8px}
.login-btn:hover{background:#7a7f5c}
</style>
</head>
<body>
<div class="login-card">
  <h1>Pala Pizza</h1>
  <p class="sub">Admin Login</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="POST" action="/admin/login">
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" required autofocus autocomplete="email">
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" required autocomplete="current-password">
    </div>
    <button type="submit" class="login-btn">Sign In</button>
  </form>
</div>
</body>
</html>
