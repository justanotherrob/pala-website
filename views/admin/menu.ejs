<%- include('layout-head', { pageTitle: 'Menu' }) %>

<style>
  tr.hidden-item td { opacity: 0.45; }
  tr.hidden-item td strong { text-decoration: line-through; }
  .vis-btn { min-width: 56px; }
  .vis-btn--hide { background: var(--warm, #F3EDE6); color: var(--mid, #5a5a5a); border: 1px solid rgba(0,0,0,0.08); }
  .vis-btn--show { background: var(--olive, #686A49); color: #fff; border: 1px solid transparent; }
</style>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
  <div>
    <h1>Menu Items</h1>
    <p class="subtitle">Manage your pizza slices and desserts. Hidden items keep their allergen data and can be shown again any time.</p>
  </div>
  <button class="btn btn-primary" onclick="showAddForm()">+ Add Item</button>
</div>

<div id="addForm" class="card" style="display:none;margin-bottom:24px">
  <h2 id="formTitle">Add Menu Item</h2>
  <form id="itemForm" onsubmit="saveItem(event)">
    <input type="hidden" id="editId" value="">
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr 80px;gap:12px;align-items:end">
      <div class="form-group" style="margin-bottom:0">
        <label>Name</label>
        <input type="text" id="itemName" required>
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label>Tag (optional)</label>
        <input type="text" id="itemTag" placeholder="e.g. v, vg">
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label>Price (pence)</label>
        <input type="number" id="itemPrice" placeholder="550">
      </div>
      <div class="form-group" style="margin-bottom:0">
        <label>Category</label>
        <select id="itemCategory">
          <option value="pizza">Pizza</option>
          <option value="dessert">Dessert</option>
        </select>
      </div>
      <div>
        <button type="submit" class="btn btn-primary btn-sm" style="width:100%">Save</button>
      </div>
    </div>
    <p style="font-size:12px;color:var(--mid);margin-top:8px">
      <strong>Pizza:</strong> Individual prices are ignored &mdash; the shared price label below is shown once for all slices.<br>
      <strong>Dessert:</strong> Each dessert shows its own price individually.
    </p>
  </form>
</div>

<!-- Pizza section -->
<div class="card" style="margin-bottom:24px">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <h2 style="margin:0">Pizza Slices</h2>
    <div style="display:flex;align-items:center;gap:12px">
      <label style="font-size:13px;color:var(--mid)">Price label:</label>
      <input type="text" id="pizzaPriceLabel" value="<%= settings.pizza_price_label || '£6 / SLICE' %>"
             style="width:160px;font-size:14px;padding:6px 10px;border:1px solid rgba(0,0,0,0.1);border-radius:6px"
             onchange="updatePriceLabel(this.value)">
    </div>
  </div>
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:80px">Order</th>
        <th>Name</th>
        <th>Tag</th>
        <th style="width:70px">Status</th>
        <th style="width:200px">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% const pizzaItems = items.filter(i => i.category === 'pizza' || !i.category); %>
      <% pizzaItems.forEach((item, i) => { %>
      <tr id="row-<%= item.id %>" class="<%= item.visible ? '' : 'hidden-item' %>">
        <td>
          <button class="btn btn-outline btn-sm" onclick="moveItem(<%= item.id %>, 'up')" <%= i === 0 ? 'disabled' : '' %> title="Move up">&uarr;</button>
          <button class="btn btn-outline btn-sm" onclick="moveItem(<%= item.id %>, 'down')" <%= i === pizzaItems.length - 1 ? 'disabled' : '' %> title="Move down">&darr;</button>
        </td>
        <td><strong><%= item.name %></strong></td>
        <td><%= item.tag || '' %></td>
        <td>
          <button class="btn btn-sm vis-btn <%= item.visible ? 'vis-btn--hide' : 'vis-btn--show' %>"
                  onclick="toggleVisible(<%= item.id %>, <%= !item.visible %>)">
            <%= item.visible ? 'Hide' : 'Show' %>
          </button>
        </td>
        <td>
          <button class="btn btn-outline btn-sm" onclick='editItem(<%= JSON.stringify(item) %>)'>Edit</button>
          <button class="btn btn-danger btn-sm" onclick="deleteItem(<%= item.id %>)">Delete</button>
        </td>
      </tr>
      <% }) %>
      <% if (pizzaItems.length === 0) { %>
      <tr><td colspan="5" style="text-align:center;color:var(--mid);padding:24px">No pizza items yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Dessert section -->
<div class="card">
  <h2 style="margin-bottom:16px">Desserts</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:80px">Order</th>
        <th>Name</th>
        <th>Tag</th>
        <th>Price</th>
        <th style="width:70px">Status</th>
        <th style="width:200px">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% const dessertItems = items.filter(i => i.category === 'dessert'); %>
      <% dessertItems.forEach((item, i) => { %>
      <tr id="row-<%= item.id %>" class="<%= item.visible ? '' : 'hidden-item' %>">
        <td>
          <button class="btn btn-outline btn-sm" onclick="moveItem(<%= item.id %>, 'up')" <%= i === 0 ? 'disabled' : '' %> title="Move up">&uarr;</button>
          <button class="btn btn-outline btn-sm" onclick="moveItem(<%= item.id %>, 'down')" <%= i === dessertItems.length - 1 ? 'disabled' : '' %> title="Move down">&darr;</button>
        </td>
        <td><strong><%= item.name %></strong></td>
        <td><%= item.tag || '' %></td>
        <td><%= item.price ? '&pound;' + (item.price / 100).toFixed(2) : '' %></td>
        <td>
          <button class="btn btn-sm vis-btn <%= item.visible ? 'vis-btn--hide' : 'vis-btn--show' %>"
                  onclick="toggleVisible(<%= item.id %>, <%= !item.visible %>)">
            <%= item.visible ? 'Hide' : 'Show' %>
          </button>
        </td>
        <td>
          <button class="btn btn-outline btn-sm" onclick='editItem(<%= JSON.stringify(item) %>)'>Edit</button>
          <button class="btn btn-danger btn-sm" onclick="deleteItem(<%= item.id %>)">Delete</button>
        </td>
      </tr>
      <% }) %>
      <% if (dessertItems.length === 0) { %>
      <tr><td colspan="6" style="text-align:center;color:var(--mid);padding:24px">No dessert items yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
function showAddForm() {
  document.getElementById('addForm').style.display = '';
  document.getElementById('formTitle').textContent = 'Add Menu Item';
  document.getElementById('editId').value = '';
  document.getElementById('itemName').value = '';
  document.getElementById('itemTag').value = '';
  document.getElementById('itemPrice').value = '';
  document.getElementById('itemCategory').value = 'pizza';
  document.getElementById('itemName').focus();
}

function editItem(item) {
  document.getElementById('addForm').style.display = '';
  document.getElementById('formTitle').textContent = 'Edit Menu Item';
  document.getElementById('editId').value = item.id;
  document.getElementById('itemName').value = item.name;
  document.getElementById('itemTag').value = item.tag || '';
  document.getElementById('itemPrice').value = item.price || '';
  document.getElementById('itemCategory').value = item.category || 'pizza';
  document.getElementById('itemName').focus();
}

async function saveItem(e) {
  e.preventDefault();
  const id = document.getElementById('editId').value;
  const data = {
    name: document.getElementById('itemName').value,
    tag: document.getElementById('itemTag').value,
    price: parseInt(document.getElementById('itemPrice').value) || null,
    category: document.getElementById('itemCategory').value,
  };

  const url = id ? '/api/menu/' + id : '/api/menu';
  const method = id ? 'PUT' : 'POST';

  const res = await fetch(url, {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });

  if (res.ok) {
    location.reload();
  } else {
    const err = await res.json();
    alert(err.error || 'Failed to save');
  }
}

async function deleteItem(id) {
  if (!confirm('Delete this menu item? This will also remove its allergen data.')) return;
  const res = await fetch('/api/menu/' + id, { method: 'DELETE' });
  if (res.ok) location.reload();
  else alert('Failed to delete');
}

async function moveItem(id, direction) {
  const res = await fetch('/api/menu/' + id + '/move', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ direction }),
  });
  if (res.ok) location.reload();
  else alert('Failed to move item');
}

async function toggleVisible(id, visible) {
  const res = await fetch('/api/menu/' + id, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ visible }),
  });
  if (res.ok) location.reload();
  else alert('Failed to update visibility');
}

async function updatePriceLabel(value) {
  const res = await fetch('/api/settings/pizza_price_label', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ value }),
  });
  if (!res.ok) alert('Failed to update price label');
}
</script>

<%- include('layout-foot') %>
